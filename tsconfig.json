  {
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node10",
    "target": "ES2023",

    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,

    "declaration": true,
    "removeComments": true,
    "sourceMap": true,

    "outDir": "./dist",
    "rootDir": ".",

    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,

    "types": ["node", "jest"]
  }
}